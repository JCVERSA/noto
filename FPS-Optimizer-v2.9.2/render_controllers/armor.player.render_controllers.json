{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.armor.player": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "(variable.is_enchanted && query.is_pack_setting_enabled('opt:enchant_glint')) ? Material.enchanted : Material.default"
        }
      ],
      "textures": [
        "variable.has_trim ? variable.trim_path : Texture.default",
        "Texture.enchanted"
      ]
    }
  }
}
